#!/bin/sh
# BusyBox udhcpc hook for clawrza-glibc-selfhost.
# This busybox exports $mask as a prefix length (24), not a dotted netmask,
# so use the `ip` applet instead of ifconfig's `netmask` argument.
case "$1" in
    deconfig)
        ip link set dev "$interface" up 2>/dev/null
        ip addr flush dev "$interface" 2>/dev/null
        ;;
    renew|bound)
        ip link set dev "$interface" up
        ip addr flush dev "$interface" 2>/dev/null
        ip addr add "$ip/$mask" dev "$interface"
        [ -n "$router" ] && ip route replace default via "$router" dev "$interface"
        if [ -n "$dns" ]; then
            : > /etc/resolv.conf
            for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
        fi
        echo "udhcpc: $interface $ip/$mask gw $router dns $dns"
        ;;
esac
exit 0
